+/*
+ * r-zig: MSYS2-style drive paths, "/c/dir" for "c:/dir" and "/c" for "c:/",
+ * as CMake's "MSYS Makefiles" generator writes them into its makefiles'
+ * commands. MSYS2's runtime understands them in its own programs and
+ * converts them in the arguments of the native programs it starts
+ * (msys2_path_conv.cc); busybox-w32 did neither. Only drive paths: there
+ * is no MSYS mount table, so "/usr/bin" stays as it is.
+ */
+int FAST_FUNC
+is_msys_drive_path(const char *path)
+{
+	return path[0] == '/' && isalpha((unsigned char)path[1]) &&
+			(path[2] == '/' || path[2] == '\0');
+}
+
+/* "c:/dir" for "/c/dir", allocated */
+char * FAST_FUNC
+msys_drive_path(const char *path)
+{
+	return xasprintf("%c:/%s", path[1], path[2] ? path + 3 : "");
+}
+
+/* Where MSYS2's find_path_start_and_type would look for a path in an
+ * argument: after leading punctuation ("@file"), the whole argument; in
+ * an option "-X/path"; else after an '=', or in an option after ',' or ':',
+ * repeatedly ("-Wl,--out-implib,/c/x", "--dir=/c/x", "VAR=/c/x"). */
+static const char *
+msys_path_start(const char *s)
+{
+	const char *p;
+	int minus;
+
+	while (*s && !isalnum((unsigned char)*s) && !strchr("/\\:-.", *s))
+		++s;
+	if (*s == '/')
+		return s;
+	minus = *s == '-';
+	p = s;
+	if (minus && isalpha((unsigned char)s[1])) {
+		p = s + 2;
+		if (*p == '/' && !strchr(p, ','))
+			return p;
+	}
+	for (; *p; ++p) {
+		if (*p == '=' || (minus && (*p == ',' || *p == ':')))
+			return msys_path_start(p + 1);
+	}
+	return NULL;
+}
+
+/* A native program's argument with its drive path converted, as MSYS2
+ * would convert it, allocated; NULL to leave it. MSYS2 leaves arguments
+ * with quotes or glob characters alone, and every argument when
+ * MSYS_NO_PATHCONV is set. */
+static char *
+msys_convert_arg(const char *arg)
+{
+	const char *p;
+
+	if (getenv("MSYS_NO_PATHCONV") || *arg == '~' || *arg == ':' ||
+			strpbrk(arg, "`'*?[]"))
+		return NULL;
+	p = msys_path_start(arg);
+	/* not a bare "/c": a native program's switch ("cmd /c", "/s") */
+	if (p == NULL || !is_msys_drive_path(p) || p[2] != '/')
+		return NULL;
+	return xasprintf("%.*s%c:/%s", (int)(p - arg), arg, p[1], p + 3);
+}
+
 static intptr_t
