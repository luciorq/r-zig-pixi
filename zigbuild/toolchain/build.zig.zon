.{
    .name = .r_zig_toolchain,
    .version = "0.0.0",
    .fingerprint = 0xdd5a39c059d920a8,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .pkgconf = .{
            .url = "https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.11.tar.xz",
            .hash = "N-V-__8AAJtPLQBQRtMEFFcqeOXniFMTNbPL0IjGxYpEnFw1",
            .lazy = true,
        },
        // GNU make's release tarball, which the build-tools group's unix
        // usr/bin/make and Windows' native/bin/make.exe are built from
        // (make.zig; zigbuild/make/build.zig compiles it, the r_zig_make
        // path dependency). The conda build passes its own unpacked copy as
        // -Dmake instead.
        .make = .{
            .url = "https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz",
            .hash = "N-V-__8AAO76hQBfZsum_DO5EZUzn1Bhfyix3mKAatVWJH40",
            .lazy = true,
        },
        .r_zig_make = .{ .path = "../make" },
        // Windows: busybox-w32's release tarball, native/bin/busybox.exe's
        // source (busybox.zig; zigbuild/busybox/build.zig compiles it, the
        // r_zig_busybox path dependency). The conda build passes its own
        // unpacked copy as -Dbusybox instead.
        .busybox = .{
            .url = "https://frippery.org/files/busybox/busybox-w32-FRP-6354-g5f09fb446.tgz",
            .hash = "N-V-__8AAAUBvgDIW2W0sn3swQsIeU5Xt2A9zDU1vnd9jCtF",
            .lazy = true,
        },
        .r_zig_busybox = .{ .path = "../busybox" },
        // Windows: Info-ZIP's zip 3.0 release tarball as Debian ships it
        // (the same sha256 as SourceForge's, zip.zig), usr/bin/zip.exe's
        // and native/bin/zip.exe's source (zigbuild/zip/build.zig compiles
        // it, the r_zig_zip path dependency). The conda build passes its
        // own unpacked copy as -Dzip instead.
        .zip = .{
            .url = "https://deb.debian.org/debian/pool/main/z/zip/zip_3.0.orig.tar.gz",
            .hash = "N-V-__8AADgXPACFlXeM929CpTtAtRBWYqrIpNY5kQ_7DTS1",
            .lazy = true,
        },
        .r_zig_zip = .{ .path = "../zip" },
        // The extras group's cmake/ (feat-extras-group): Kitware's release
        // archives (cmake.zig pins them with Kitware's sha256; the test
        // step checks these URLs are its). Each .hash is what a build's own
        // fetch computes: a `zig fetch <url>` run outside a build caches
        // the tree under its top directory (zig 0.17). A broken cached copy
        // of any entry here fails every build of this build.zig.zon, asked
        // for or not (zig unpacks every cached lazy dependency): delete
        // p/<hash>.tar.gz from zig's global cache.
        .cmake_linux_x86_64 = .{
            .url = "https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-linux-x86_64.tar.gz",
            .hash = "N-V-__8AAP7kWAvB8Sz7VQ-H2TsS32GZpfIyEP2nZx7xeH_0",
            .lazy = true,
        },
        .cmake_linux_aarch64 = .{
            .url = "https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-linux-aarch64.tar.gz",
            .hash = "N-V-__8AAMe3OQcfr2sIFOyh0053trgFzti-ioG9UD_IdiJd",
            .lazy = true,
        },
        .cmake_macos_universal = .{
            .url = "https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-macos-universal.tar.gz",
            .hash = "N-V-__8AAIlSEA-hX49kdtISa7HIXS3XN39KRJpam_J0gPRt",
            .lazy = true,
        },
        .cmake_windows_x86_64 = .{
