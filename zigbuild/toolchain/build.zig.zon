.{
    .name = .r_zig_toolchain,
    .version = "0.0.0",
    .fingerprint = 0xdd5a39c059d920a8,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .pkgconf = .{
            .url = "https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.11.tar.xz",
            .hash = "N-V-__8AAJtPLQBQRtMEFFcqeOXniFMTNbPL0IjGxYpEnFw1",
            .lazy = true,
        },
        // unix: GNU make's release tarball, which the build-tools group's
        // usr/bin/make is built from (make.zig; zigbuild/make/build.zig
        // compiles it, the r_zig_make path dependency). The conda build
        // passes its own unpacked copy as -Dmake instead.
        .make = .{
            .url = "https://ftp.gnu.org/gnu/make/make-4.4.1.tar.gz",
            .hash = "N-V-__8AAO76hQBfZsum_DO5EZUzn1Bhfyix3mKAatVWJH40",
            .lazy = true,
        },
        .r_zig_make = .{ .path = "../make" },
        // The extras group's cmake/ (feat-extras-group): Kitware's release
        // archives (cmake.zig pins them with Kitware's sha256; the test
        // step checks these URLs are its). Each .hash is what a build's own
        // fetch computes: a `zig fetch <url>` run outside a build caches
        // the tree under its top directory (zig 0.17). A broken cached copy
        // of any entry here fails every build of this build.zig.zon, asked
        // for or not (zig unpacks every cached lazy dependency): delete
        // p/<hash>.tar.gz from zig's global cache.
        .cmake_linux_x86_64 = .{
            .url = "https://github.com/Kitware/CMake/releases/download/v4.4.5/cmake-4.4.5-linux-x86_64.tar.gz",
