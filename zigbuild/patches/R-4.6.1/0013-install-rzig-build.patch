+        ## r-zig: the native library through zig build alone, no make and
+        ## no shell, when the package qualifies (no configure, no
+        ## src/Makefile, a Makevars of assignments only, or its own
+        ## src/build.zig): `rzig build` in R_HOME/bin/toolchain classifies
+        ## the package, derives from Makeconf and the Makevars what make
+        ## would have run, and runs it as zig build steps that call the same
+        ## compilers. Exit 3 means the package needs make, and the make
+        ## path below runs as before; a src/build.zig package that make
+        ## cannot build (make ignores build.zig) exits 1, a failure, after
+        ## rzig's line saying why [preflight-PF-1]. R_ZIG_PKG_BUILDER =
+        ## auto (default), zig (an error where this hook would hand the
+        ## package to make: a tier-3 package, or no rzig [preflight-PF-4];
+        ## a src/Makefile package goes to make without coming here), make
+        ## (never rzig). R_ZIG_JOBS, else MAKEFLAGS' -j, sets the
+        ## parallelism.
+        ## .github/devdocs/feat-zig-pkg-build/PLAN.md.
+        rzig_build <- function(pkg_name, instdir, arch, use_LTO)
+        {
+            builder <- Sys.getenv("R_ZIG_PKG_BUILDER", "auto")
+            if (builder == "make") return(NA)
+            rzig <- file.path(R.home(), "bin", "toolchain",
+                              if (WINDOWS) "rzig.exe" else "rzig")
+            if (!file.exists(rzig)) {
+                ## CC's binary without the rzig name is a toolchain older
+                ## than this R, not a tree without one (the preflight
+                ## above checked CC's): say so, instead of a make path
+                ## that may find no make
+                cc <- file.path(R.home(), "bin", "toolchain",
+                                if (WINDOWS) "gcc.exe" else "zig-cc")
+                if (file.exists(cc))
+                    pkgerrmsg(paste0("R_HOME/bin/toolchain has ", basename(cc),
+                                     " but not ", basename(rzig),
+                                     ": the r-zig toolchain is older than this R"),
+                              pkg_name)
+                ## R_ZIG_PKG_BUILDER=zig means no make path, here too,
+                ## where there is no rzig to ask [preflight-PF-4]
+                if (builder == "zig")
+                    pkgerrmsg("R_ZIG_PKG_BUILDER is 'zig' and R_HOME/bin/toolchain has no rzig",
+                              pkg_name)
+                return(NA)
+            }
+            args <- c("build", "--pkg", "..", "--src", ".", "--out", ".",
+                      "--flat", "--name", pkg_name)
+            if (isTRUE(use_LTO)) args <- c(args, "--use-lto", "yes")
+            else if (isFALSE(use_LTO)) args <- c(args, "--use-lto", "no")
+            if (!is.na(use_C)) args <- c(args, "--c-std", as.character(use_C))
+            if (WINDOWS && debug) args <- c(args, "--debug")
+            jobs <- Sys.getenv("R_ZIG_JOBS")
+            if (!nzchar(jobs))
+                jobs <- regmatches(Sys.getenv("MAKEFLAGS"),
+                                   regexpr("(?<=-j)[0-9]+", Sys.getenv("MAKEFLAGS"),
+                                           perl = TRUE))
+            if (length(jobs) == 1L && grepl("^[0-9]+$", jobs))
+                args <- c(args, "-j", jobs)
+            ## the user Makevars R found, which rzig then reads in place of
+            ## its own lookup: R's `~` falls back to the passwd home when
+            ## HOME is unset (unix), rzig's does not [code-5]. When R found
+            ## none, neither does rzig (Windows could not hold the empty
+            ## value that says so). The caller's value comes back after.
+            mu <- makevars_user()
+            mu_was <- Sys.getenv("R_MAKEVARS_USER", NA_character_)
+            if (length(mu)) Sys.setenv(R_MAKEVARS_USER = mu)
+            status <- if (WINDOWS) system2(rzig, shQuote(args))
+                      else .Internal(spawnWait(c(rzig, args), 0L))
+            if (is.na(mu_was)) Sys.unsetenv("R_MAKEVARS_USER")
+            else Sys.setenv(R_MAKEVARS_USER = mu_was)
+            if (identical(status, 3L)) {
+                if (builder == "zig")
+                    pkgerrmsg("this package needs make, and R_ZIG_PKG_BUILDER is 'zig'",
+                              pkg_name)
+                return(NA)
+            }
+            if (status != 0L) return(TRUE)
+            shlib_install(instdir, arch)
+            FALSE
+        }
+
