-    if (!cmd)
-	return R_system(cmd);
 
+   r-zig: the same machinery runs a program by argument vector, without
+   /bin/sh, when argv is given (R_spawn_timeout, .Internal(spawnWait)):
+   what R CMD INSTALL uses to start rzig build. */
+static int R_run_timeout(const char *cmd, char *const argv[], int timeout)
+{
     /* Earlier version of R would block SIGPROF here on old Apple systems
        following Luke's recommendation on how to fix PR#1140 (see R_open,
        R_system). */
@@ -665,8 +665,11 @@
 	signal(SIGTTIN, SIG_DFL);
 	signal(SIGTTOU, SIG_DFL);
 
-	execl("/bin/sh", "sh", "-c", cmd, (char *)NULL);
-	_exit(127); /* execl failed */
+	if (argv)
+	    execvp(argv[0], argv);
+	else
+	    execl("/bin/sh", "sh", "-c", cmd, (char *)NULL);
+	_exit(127); /* exec failed */
     } else if (tost.child_pid > 0) {
 	/* parent */
 	if (tost.have_alarm) {
@@ -700,6 +703,45 @@
 	return -1;
 }
 
+static int R_system_timeout(const char *cmd, int timeout)
+{
+    if (!cmd)
+	return R_system(cmd);
+    return R_run_timeout(cmd, NULL, timeout);
+}
+
+/* r-zig: .Internal(spawnWait(argv, timeout)): run argv[0] with these
+   arguments, found on PATH when it is a bare name, no shell; wait for it
+   and return its exit status as system() does (127 when it cannot be
+   started, 124 after the timeout, in seconds; 0 = none). */
+attribute_hidden SEXP do_spawnwait(SEXP call, SEXP op, SEXP args, SEXP rho)
+{
+    checkArity(op, args);
+    SEXP sargv = CAR(args);
+    if (!isString(sargv) || LENGTH(sargv) < 1)
+	error(_("non-empty character argument expected"));
+    int timeout = asInteger(CADR(args));
+    if (timeout == NA_INTEGER || timeout < 0)
+	error(_("invalid '%s' argument"), "timeout");
+    int n = LENGTH(sargv);
+    const void *vmax = vmaxget();
+    char **argv = (char **) R_alloc(n + 1, sizeof(char *));
+    for (int i = 0; i < n; i++)
+	argv[i] = (char *) translateCharFP(STRING_ELT(sargv, i));
+    argv[n] = NULL;
+    int res = R_run_timeout(NULL, argv, timeout);
+    if (res == -1) {
+	warning(_("system call failed: %s"), strerror(errno));
+	res = 127;
+    }
+    if (timeout && tost.timedout) {
+	res = 124;
+	warning(_("command '%s' timed out after %ds"), argv[0], timeout);
+    }
+    vmaxset(vmax);
+    return ScalarInteger(res);
+}
+
