+++ b/src/scripts/R.sh.in
@@ -120,7 +120,7 @@
 
 ## some systems have a more portable sed, e.g. /usr/xpg4/bin/sed on Solaris,
 ## so make sure that is used.
-SED=@SED@
+SED=sed # r-zig: bin/R itself uses no sed
 export SED
 
 error () {
@@ -129,6 +129,21 @@
 }
 
 ### Argument loop
+## r-zig: no sed. has_value: the next word exists and isn't an option.
+## replace_all STRING FROM TO sets _r to STRING with every FROM replaced.
+has_value () { case "${1}" in ""|-*) return 1 ;; esac; }
+replace_all () {
+  _s="${1}"; _r=
+  while :; do
+    case "${_s}" in
+      *"${2}"*) _r="${_r}${_s%%"${2}"*}${3}"; _s="${_s#*"${2}"}" ;;
+      *) _r="${_r}${_s}"; return 0 ;;
+    esac
+  done
+}
+NL='
+'
+TAB='	'
 args=
 debugger=
 debugger_args=
