+            !length(makevars_user()) && !nzchar(Sys.getenv("R_ZIG_NO_PREFLIGHT"))) {
+            ## (R.home("bin") is bin/x64 on Windows)
+            rzig <- file.path(R.home(), "bin", "toolchain",
+                              if (WINDOWS) "gcc.exe" else "zig-cc")
+            ## no rzig: R without its toolchain package, which the
+            ## distribution's R_ZIG_TOOLCHAIN_HINT names
+            if (!file.exists(rzig))
+                pkgerrmsg(paste0("this package has compiled code, and the r-zig toolchain is not installed: ",
+                                 Sys.getenv("R_ZIG_TOOLCHAIN_HINT",
+                                            "install the r-zig toolchain package for this R")),
+                          pkg_name)
+            ## What rzig build will see, through the environment (system2's
+            ## env = is not supported on Windows): the C standard, and
+            ## whether R runs a configure script. A check that fails says on
+            ## stderr what is missing (rzig's own reason when make is needed)
+            ## and how to install its group, shown as it comes, and exits
+            ## non-zero (127: not through intern = TRUE, which makes that an
+            ## error of R's own); a passing one's line, on stdout, is not
+            ## shown.
+            Sys.setenv(R_ZIG_CONFIGURE = if (configure_runs) "1" else "0",
+                       R_ZIG_C_STD = if (is.na(use_C)) "" else as.character(use_C))
+            status <- suppressWarnings(system2(rzig, "--rzig-check=package", stdout = FALSE))
+            Sys.unsetenv(c("R_ZIG_CONFIGURE", "R_ZIG_C_STD"))
+            if (status != 0L)
+                pkgerrmsg("this package has compiled code, and the r-zig toolchain is incomplete (see above)",
+                          pkg_name)
+        }
