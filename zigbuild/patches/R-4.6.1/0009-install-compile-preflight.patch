+            pkgerrmsg(paste0("this package has compiled code, and the r-zig toolchain is not installed: ",
+                             Sys.getenv("R_ZIG_TOOLCHAIN_HINT",
+                                        "install the r-zig toolchain package for this R")),
+                      pkg_name)
