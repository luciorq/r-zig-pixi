+
+## r-zig (patch 0018): with R_ZIG_NATIVE_TOOLS on (1, true, yes), the native
+## build tools (R_HOME/bin/toolchain/native/bin, r-zig-native-tools) before
+## those, as R CMD INSTALL and SHLIB put them (tools' .rzig_native_tools),
+## so that the session's Sys.which("make") (install.packages()) and
+## system("sh ...") find the same make and sh. A missing directory is
+## harmless here; R CMD warns. tools' .rzig_on (patch 0009) reads the
+## value, and warns on one that is neither on nor off; tools is loaded
+## only when the variable is set, and an R without it (R's own build)
+## takes it as off.
+local({
+    if (nzchar(Sys.getenv("R_ZIG_NATIVE_TOOLS")) &&
+        isTRUE(tryCatch(tools:::.rzig_on("R_ZIG_NATIVE_TOOLS"), error = function(e) FALSE)))
+        Sys.setenv(PATH = paste0(file.path(R.home(), "bin", "toolchain", "native", "bin"), ";", Sys.getenv("PATH")))
+})
