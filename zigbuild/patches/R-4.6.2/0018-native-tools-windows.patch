 } ## .install_packages()
 
+## r-zig (patch 0018): the native build tools on Windows, an opt-in. With
+## R_ZIG_NATIVE_TOOLS on (.rzig_on: 1, true or yes), R_HOME/bin/toolchain/native/bin
+## (the r-zig-native-tools package: busybox-w32's sh and tools, GNU make
+## built for Windows, pkgconf) goes first on PATH, before the build-tools
+## group's MSYS2 tools that etc/Rcmd_environ puts there, for configure
+## scripts and make. CMake's MSYS Makefiles generator (Rcmd_environ's
+## CMAKE_GENERATOR default) writes /c/ paths for MSYS2's sh, so it
+## becomes Unix Makefiles, whose c:/ paths need no conversion; a generator
+## set otherwise stays. CONFIG_SHELL is sh, unless set, for autoconf
+## scripts that look for a better shell. Without the directory, a warning
+## and nothing else. Once per process (R CMD INSTALL calls it, then
+## .shlib_internal again).
+.rzig_native_tools <- function()
+{
+    if (.Platform$OS.type != "windows" || !.rzig_on("R_ZIG_NATIVE_TOOLS"))
+        return(invisible(FALSE))
+    dir <- file.path(R.home(), "bin", "toolchain", "native", "bin")
+    if (!file.exists(file.path(dir, "busybox.exe"))) {
+        warning(gettextf("R_ZIG_NATIVE_TOOLS is on, but %s has no busybox.exe (r-zig-native-tools is not installed)",
+                         dir), call. = FALSE, domain = NA)
+        return(invisible(FALSE))
+    }
+    path <- Sys.getenv("PATH")
+    if (!startsWith(path, paste0(dir, ";")))
+        Sys.setenv(PATH = paste0(dir, ";", path))
+    if (Sys.getenv("CMAKE_GENERATOR") %in% c("", "MSYS Makefiles"))
+        Sys.setenv(CMAKE_GENERATOR = "Unix Makefiles")
+    if (!nzchar(Sys.getenv("CONFIG_SHELL"))) Sys.setenv(CONFIG_SHELL = "sh")
+    invisible(TRUE)
+}
+
