+## r-zig (patch 0013; feat-zig-pkg-build, feat-shlib-rzig-build): the
+## native library through zig build alone, before .shlib_internal's make
+## path: `rzig build` for R CMD INSTALL's package (`pkg`, from
+## run_shlib), `rzig build --shlib` for R CMD SHLIB's files. NA: the make
+## path (R_ZIG_PKG_BUILDER=make, no rzig, or rzig's exit 3 = needs make);
+## otherwise rzig's status, which .shlib_internal returns: any other
+## non-zero status fails, never runs make [shlib-r-1].
+## Every rule lives here: TMB keeps .shlib_internal's body from the R
+## that installed it (TMB.R), so arguments are added, with defaults,
+## never removed or renamed. R_ZIG_PKG_BUILDER = auto (default), zig (an
+## error where make would run: a call that needs make, or no rzig
+## [preflight-PF-4]; a src/Makefile package goes to make without coming
+## here), make (never rzig). R_ZIG_JOBS, else MAKEFLAGS' -j, sets the
+## parallelism. .github/devdocs/feat-zig-pkg-build/PLAN.md,
+## .github/devdocs/feat-shlib-rzig-build/PLAN.md.
+.rzig_build <- function(pkg = NULL, files = character(), output = "",
+                        pkg_libs = character(), use_lto = NA, use_C = "",
+                        debug = FALSE, dry_run = FALSE)
+{
+    builder <- Sys.getenv("R_ZIG_PKG_BUILDER", "auto")
+    if (builder == "make" || (is.null(pkg) && !length(files))) return(NA)
+    zig_only <- builder == "zig" && !dry_run
+    stop_zig <- function(msg) {
+        message("ERROR: ", msg,
+                if (!is.null(pkg)) paste(" for package", sQuote(pkg)) else "",
+                domain = NA)
+        1L
+    }
+    windows <- .Platform$OS.type == "windows"
+    rzig <- file.path(R.home(), "bin", "toolchain",
+                      if (windows) "rzig.exe" else "rzig")
+    ## no rzig: a damaged tree, since every channel ships it with R
+    ## (feat-standalone-toolchain phase 4); the make path, unless
+    ## R_ZIG_PKG_BUILDER=zig, which means no make path [preflight-PF-4]
+    if (!file.exists(rzig))
+        return(if (zig_only)
+                   stop_zig("R_ZIG_PKG_BUILDER is 'zig' and R_HOME/bin/toolchain has no rzig")
+               else NA)
+    args <- if (is.null(pkg))
+                c("build", "--shlib", "--output", output,
+                  if (length(pkg_libs))
+                      c("--pkg-libs", paste(pkg_libs, collapse = " ")),
+                  if (dry_run) "--dry-run")
+            else c("build", "--pkg", "..", "--src", ".", "--out", ".",
+                   "--flat", "--name", pkg)
+    if (isTRUE(use_lto)) args <- c(args, "--use-lto", "yes")
+    else if (isFALSE(use_lto)) args <- c(args, "--use-lto", "no")
+    if (!is.na(use_C) && nzchar(use_C))
+        args <- c(args, "--c-std", as.character(use_C))
+    if (windows && debug) args <- c(args, "--debug")
+    jobs <- Sys.getenv("R_ZIG_JOBS")
+    if (!nzchar(jobs))
+        jobs <- regmatches(Sys.getenv("MAKEFLAGS"),
+                           regexpr("(?<=-j)[0-9]+", Sys.getenv("MAKEFLAGS"),
+                                   perl = TRUE))
+    if (length(jobs) == 1L && grepl("^[0-9]+$", jobs))
+        args <- c(args, "-j", jobs)
+    if (is.null(pkg)) args <- c(args, "--", files)
+    ## the user Makevars R found, which rzig then reads in place of its
+    ## own lookup: R's `~` falls back to the passwd home when HOME is unset
+    ## (unix), rzig's does not [code-5]. When R found none, neither does
+    ## rzig (Windows could not hold the empty value that says so). The
+    ## caller's value comes back after.
+    mu <- makevars_user()
+    mu_was <- Sys.getenv("R_MAKEVARS_USER", NA_character_)
+    if (length(mu)) Sys.setenv(R_MAKEVARS_USER = mu)
+    on.exit(if (is.na(mu_was)) Sys.unsetenv("R_MAKEVARS_USER")
+            else Sys.setenv(R_MAKEVARS_USER = mu_was))
+    ## R's session directory, where R CMD SHLIB's build root goes (open
+    ## point M b): unix R names it to every child in R_SESSION_TMPDIR,
+    ## Windows R sets none (sysutils.c, #ifndef Win32), so this one names
+    ## it there, and the caller's value comes back after
+    ## (feat-shlib-rzig-build round 1, kappa)
+    if (windows) {
+        st_was <- Sys.getenv("R_SESSION_TMPDIR", NA_character_)
+        Sys.setenv(R_SESSION_TMPDIR = tempdir())
+        on.exit(if (is.na(st_was)) Sys.unsetenv("R_SESSION_TMPDIR")
+                else Sys.setenv(R_SESSION_TMPDIR = st_was), add = TRUE)
+    }
+    ## what R printed comes first: the dry run's "make would use", which
+    ## Rcpp's macOS OpenMP plugin reads the next line after, through a pipe
+    ## (system() flushes too; spawnWait does not)
+    flush(stdout())
+    ## R's Windows system() reads exit status 127 as a failed launch
+    ## (run.h's NOLAUNCH) and warns "Exit code was 127", which only
+    ## repeats rzig's own text (no zig; a call that needs make, and no
+    ## make); a launch that really failed keeps its warning
+    no127 <- function(w)
+        if (identical(conditionMessage(w),
+                      gettextf("Exit code was %d", 127L, domain = "R")))
+            invokeRestart("muffleWarning")
+    status <- if (windows)
+                  withCallingHandlers(system2(rzig, shQuote(args)),
+                                      warning = no127)
+              else .Internal(spawnWait(c(rzig, args), 0L))
+    ## a child a signal ends reads as its raw wait status (sys-unix.c):
+    ## Ctrl-C (SIGINT, forwarded to rzig) reads as 2, a failure, so no
+    ## status but 3 starts make [shlib-r-1]; SIGQUIT reads as 3
+    if (identical(status, 3L))
+        return(if (zig_only)
+                   stop_zig(paste(if (is.null(pkg)) "this shared object"
+                                  else "this package",
+                                  "needs make, and R_ZIG_PKG_BUILDER is 'zig'"))
+               else NA)
+    status
+}
