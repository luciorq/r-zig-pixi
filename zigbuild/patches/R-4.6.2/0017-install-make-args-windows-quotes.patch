                             sprintf(c("CC='$(CC%s)'", "CFLAGS='$(C%sFLAGS)'"), use_C)
                         else character()
+                    ## r-zig (patch 0017): double quotes for a native make (a Windows host)
+                    if (.Platform$OS.type == "windows") makeargs <- gsub("'", "\"", makeargs, fixed = TRUE)
                     cmd <- paste("make --no-print-directory",
                                  p1("-f", shQuote(makefiles)),
                                  p1(makeargs))
@@ -2959,6 +2961,13 @@
