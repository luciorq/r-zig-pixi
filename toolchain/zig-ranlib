#!/usr/bin/env bash
# zig: $ZIG_BIN if executable, else PATH, else the ziglang package — see zig-cc.
if [ -n "${ZIG_BIN:-}" ] && [ -x "$ZIG_BIN" ]; then
  ZIG=("$ZIG_BIN")
elif _zig="$(command -v zig || command -v x86_64-w64-mingw32-zig)"; then
  ZIG=("$_zig")
else
  ZIG=(python3 -m ziglang)
fi
exec "${ZIG[@]}" ranlib "$@"
