#!/usr/bin/env bash
# C compiler shim: zig cc as a single-word $CC for autoconf/make.
#
# -fno-sanitize=undefined: zig cc enables UBSan trap mode by default;
# R's numeric code contains benign UB that would otherwise SIGILL at runtime.
#
# -mcpu=baseline, on every OS: the baseline CPU of the target's arch, as
# build.zig compiles R itself. A target naming the arch (linux's and
# macOS's below) resolves to it already; no target (Windows) would be the
# compiling machine's own CPU (AVX2, AVX-512), and packages compiled on
# one machine load on others. Before the caller's arguments, so a
# package's own -march/-mcpu wins; its -mtune= goes (below), since zig
# would take that as the CPU too. rzig: zigbuild/tools/rzig/compiler.zig.
#
# -Wno-error=date-time: zig cc adds -Werror=date-time at -O1 and above, so
# a __DATE__ or __TIME__ stops the compile (duckdb, arrow's mimalloc); gcc
# and clang only warn. -g0 unless the caller passes a -g option: zig cc
# emits DWARF without -g, and Makeconf's CFLAGS are -O2 alone (an
# installed linux .so kept it: mlpack 304 MB). rzig: compiler.zig.
#
# SONAME injection: GNU ld records a bare "libR.so" as DT_NEEDED when a
# library has no SONAME; zig's lld records the literal path it resolved
# (e.g. "../../lib/libR.so"), which breaks at runtime. When linking a
# shared library named lib*.so with no explicit -soname, add one.
#
# zig to exec: $ZIG_BIN when it names an executable — the r-zig wheel
# (scripts/make-wheel.py) points it at the PyPI `ziglang` package's own
# binary — else zig on PATH (the conda/pixi env's; on win-64 conda-forge
# only installs it as x86_64-w64-mingw32-zig), else `python3 -m ziglang`
# (the wheel with ziglang installed outside R's own site-packages dir).
if [ -n "${ZIG_BIN:-}" ] && [ -x "$ZIG_BIN" ]; then
  ZIG=("$ZIG_BIN")
elif _zig="$(command -v zig || command -v x86_64-w64-mingw32-zig)"; then
  ZIG=("$_zig")
else
  ZIG=(python3 -m ziglang)
fi

# libc++ is linked statically, everywhere (decided 2026-09-30). Upstream
# zig always does; conda-forge's zig (feedstock patch Lld.zig-prefer-
# shared-libcxx) links a shared libc++ instead whenever one sits in
# <zig lib dir>/../../lib, which is always the case in a macOS conda env
# and in any env that has the `libcxx` package. The probe is relative to
# the lib dir, so point ZIG_LIB_DIR at a mirror of it (a directory of
# symlinks, nested as <mirror>/lib/zig so that <mirror>/lib has no libc++).
# Kept in the user's cache, one per zig lib dir, made once: mkdir is the
# lock for parallel make jobs, .complete the marker. Unix only (MSYS's
# ln -s copies; no win-64 env has libc++.dll.a). rzig's
# zigbuild/tools/rzig/libcxx_mirror.zig does the same (parity-test.sh),
# and build.zig uses it for R's own build (staticLibcxxLibDir).
r_zig_static_libcxx() {
  local zl="${ZIG_LIB_DIR:-}" d m key e i
  if [ -z "$zl" ] && [ "${ZIG[0]}" != python3 ]; then
    d="${ZIG[0]%/*}"; [ "$d" = "${ZIG[0]}" ] && d=.
    [ -f "$d/../lib/zig/std/std.zig" ] && zl="$d/../lib/zig"
  fi
  [ -n "$zl" ] && [ -d "$zl" ] || return 0
  for e in libc++.1.dylib libc++.dylib libc++.so.1 libc++.so; do
    [ -e "$zl/../../lib/$e" ] && break
    e=""
  done
  [ -n "$e" ] || return 0
  zl="$(cd "$zl" && pwd -P)"
  key="$( { echo "$zl"; ls "$zl"; } | cksum | cut -d' ' -f1)"
  m="${XDG_CACHE_HOME:-${HOME:-/tmp}/.cache}/r-zig/zig-lib-$key"
  if [ ! -e "$m/.complete" ]; then
    if mkdir -p "${m%/*}" 2>/dev/null && mkdir "$m" 2>/dev/null; then
      mkdir -p "$m/lib/zig" && for e in "$zl"/*; do ln -s "$e" "$m/lib/zig/"; done && : > "$m/.complete"
    else
      i=0; while [ ! -e "$m/.complete" ] && [ "$i" -lt 100 ]; do sleep 0.1; i=$((i + 1)); done
    fi
  fi
  if [ -e "$m/.complete" ]; then
    export ZIG_LIB_DIR="$m/lib/zig"
  else
    echo "zig-cc: could not prepare $m; this link may use a shared libc++" >&2
  fi
}
case "$(uname -s 2>/dev/null)" in MINGW*|MSYS*) ;; *) r_zig_static_libcxx ;; esac

# Linux: pin the same glibc 2.17 floor build.zig uses for R itself
# (HPC servers on old distros — RHEL/CentOS 7 era). Without this,
# packages compiled through this shim (R CMD INSTALL/SHLIB) default to
# zig's native glibc resolution — whatever's actually on the machine
# doing the compiling, not necessarily the machine that later dyn.load()s
# the result (HPC clusters routinely build on a newer head/login node and
# run on older compute nodes). No downside: glibc's ABI is strictly
# backward compatible, so this is a floor, not a restriction. Windows/
# macOS have no glibc concept, so this only applies when uname reports a
# real Linux kernel (not MSYS's "MINGW64_NT"/"MSYS_NT").
target=()
sdkL=()
if [[ "$(uname -s 2>/dev/null)" == "Linux" ]]; then
  target=(-target "$(uname -m)-linux-gnu.2.17")
fi
# macOS: the same floor idea, as a deployment target (13.0, R's own; see
# build.zig). The OS word must be the literal "native" plus MAJOR.MINOR:
# zig then treats the OS as non-native (LC_BUILD_VERSION minos 13.0, and
# no implicit LC_RPATH per -L directory) but still finds the installed
# SDK's headers and libSystem. "<arch>-macos.13.0" would lose the SDK's
# usr/include (net/if_media.h, which ps needs), and "<arch>-native.13" is
# rejected. Two SDK search dirs that the non-native link leaves out come
# back by hand: -F<sdk>/System/Library/Frameworks (-framework X at link)
# and -L<sdk>/usr/lib (SDK-only libs: -lz -liconv -lcurl -lresolv), the
# latter LAST on link lines only, so a -lz whose headers came from a -L
# directory the caller passed binds that library, not the SDK's .tbd.
# -mmacosx-version-min and MACOSX_DEPLOYMENT_TARGET are ignored by zig.
if [[ "$(uname -s 2>/dev/null)" == "Darwin" ]]; then
  case "$(uname -m)" in arm64|aarch64) _arch=aarch64 ;; *) _arch=x86_64 ;; esac
  target=(-target "$_arch-native.13.0")
  _sdk="$(/usr/bin/xcrun --sdk macosx --show-sdk-path 2>/dev/null)"
  if [ -n "$_sdk" ]; then
    target+=("-F$_sdk/System/Library/Frameworks")
    sdkL=("-L$_sdk/usr/lib")
  fi
fi

# -mtune=<cpu>: zig cc takes it as the CPU to compile for, as it takes
# -mcpu and -march (gcc, clang and flang only tune for it): after
# -mcpu=baseline, -mtune=native compiles for this machine's CPU, and a
# gcc spelling zig has no CPU for (-mtune=generic) fails. So a Makevars'
# portable -mtune=native would make a package that needs the compiling
# machine's CPU. Dropped: zig tunes for "generic" anyway. The value of
# -Xarch_<arch> stays: zig hands it to clang's driver. rzig:
# compiler.zig's dropTune.
_a=(); _p=
for a in "$@"; do case "$_p:$a" in -Xarch_*:*) _a+=("$a") ;; *:-mtune=*) ;; *) _a+=("$a") ;; esac; _p=$a; done
set -- "${_a[@]}"

# -march=armv<N>[.<M>]-a[+ext...], an Arm architecture: zig reads -march
# as a CPU name ("unknown CPU: 'armv8'"), so the same request in zig's
# words, -mcpu=generic+v<N>[_<M>]a[+feature...], clang's extension names
# in zig's spelling (no<x> as -<x>, - as _). Where the caller put it,
# after -mcpu=baseline, so it wins. The value of -Xarch_<arch> stays
# clang's: zig hands it to clang's driver, which refuses zig's -mcpu
# (abseil's CMake on macOS). rzig: compiler.zig's marchArgs.
_a=(); _p=
for a in "$@"; do
  case "$_p" in -Xarch_*) _a+=("$a"); _p=$a; continue ;; esac
  _p=$a
  case "$a" in
    -march=armv*)
      _v=${a#-march=}; _arch=${_v%%+*}; _ver=${_arch#armv}; _ver=${_ver%-a}
      case "$_arch:$_ver" in
        *-a:*[!0-9.]*|*-a:) _a+=("$a") ;;
        *-a:*)
          _m="-mcpu=generic+v${_ver//./_}a"; _e=${_v#"$_arch"}
          while [ -n "$_e" ]; do
            _e=${_e#+}; _x=${_e%%+*}; _e=${_e#"$_x"}
            [ -n "$_x" ] || continue
            _s=+; case "$_x" in no?*) _s=-; _x=${_x#no} ;; esac
            case "$_x" in
              simd) _x=neon ;; fp) _x=fp_armv8 ;; fp16) _x=fullfp16 ;; rdma) _x=rdm ;;
              rng) _x=rand ;; memtag) _x=mte ;; profile) _x=spe ;; fcma) _x=complxnum ;;
              jscvt) _x=jsconv ;; pmuv3) _x=perfmon ;; predres2) _x=specres2 ;;
            esac
            _m="$_m$_s${_x//-/_}"
          done
          _a+=("$_m") ;;
        *) _a+=("$a") ;;
      esac ;;
    *) _a+=("$a") ;;
  esac
done
set -- "${_a[@]}"

# Linker options zig cannot take, in every spelling (inside -Wl, as one
# item or two, after -Xlinker, and -z on its own). -L<dir> and
# --library-path=<dir> ("unsupported linker arg", RcppParallel) become the
# driver's -L<dir>; --dependency-file (CMake's, which crashes zig) and
# --allow-multiple-definition or -z muldefs (rejected; a real duplicate
# then fails loudly) go. rzig: linker_args.zig.
_li() { # _li ITEM [NEXT]: what becomes of linker option ITEM: _act, _val, _n
  _act=keep _val= _n=1
  case "$1" in
    -L|--library-path) [ $# -ge 2 ] && [ -n "$2" ] && { _act=lib _val=$2 _n=2; } ;;
    --dependency-file) _act=drop; [ $# -ge 2 ] && _n=2 ;;
    -z) [ $# -ge 2 ] && [ "$2" = muldefs ] && { _act=drop _n=2; } ;;
    -L?*) _act=lib _val=${1#-L} ;;
    --library-path=?*) _act=lib _val=${1#--library-path=} ;;
    --dependency-file=*|--allow-multiple-definition|-allow-multiple-definition|-zmuldefs) _act=drop ;;
  esac
}
_a=()
while [ $# -gt 0 ]; do
  a=$1; shift
  case "$a" in
    -Wl,*)
      _w=() _k=() _ch=0 _r="${a#-Wl,},"
      while [ -n "$_r" ]; do _w+=("${_r%%,*}"); _r=${_r#*,}; done
      i=0
      while [ $i -lt ${#_w[@]} ]; do
        if [ $((i + 1)) -lt ${#_w[@]} ]; then _li "${_w[i]}" "${_w[i + 1]}"; else _li "${_w[i]}"; fi
        case $_act in
          keep) _k+=("${_w[i]}") ;;
          drop) _ch=1 ;;
          lib) _a+=("-L$_val"); _ch=1 ;;
        esac
        i=$((i + _n))
      done
      if [ $_ch = 0 ]; then _a+=("$a")
      elif [ ${#_k[@]} -gt 0 ]; then _a+=("-Wl,$(IFS=,; printf '%s' "${_k[*]}")"); fi ;;
    -Xlinker)
      if [ $# -eq 0 ]; then _a+=("$a"); continue; fi
      if [ $# -ge 3 ] && [ "$2" = -Xlinker ]; then _li "$1" "$3"; else _li "$1"; fi
      case $_act in
        keep) _a+=("$a" "$1"); shift; continue ;;
        lib) _a+=("-L$_val") ;;
      esac
      if [ $_n = 2 ]; then shift 3; else shift; fi ;;
    -z)
      if [ "${1:-}" = muldefs ]; then shift; else _a+=("$a"); fi ;;
    *) _a+=("$a") ;;
  esac
done
set -- "${_a[@]}"

# Fortran runtime: Makeconf's FLIBS says -lflang_rt.runtime (feat-no-
# host-paths F1.5). Link the static archive of the flang on PATH, the
# compiler FC runs, wherever its LLVM keeps it (<resource dir>/lib/
# <triple>/): never a shared runtime, which would need an rpath into the
# environment at load time (conda-forge's linux-64 flang-rt ships one next
# to the archive), and not tied to the LLVM major R was built with. Once:
# R CMD SHLIB repeats $(FLIBS). No flang on PATH: nothing this link has
# was compiled by it, so the flag goes (CRAN's usual `PKG_LIBS =
# $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)` puts it on C and C++ links too). A
# flang without the archive: dropped with a warning, so only a Fortran
# package fails, at its load test. -lgfortran and -lquadmath, as a
# Makevars written for gcc names them, are this runtime too, on every OS:
# FC is flang, and gfortran's runtime defines nothing flang's code calls.
# The first of the three becomes the archive. rzig: flang_rt.zig.
case " $* " in
  *" -lflang_rt.runtime "*|*" -lgfortran "*|*" -lquadmath "*)
    _frt=""
    if _rd="$(flang -print-resource-dir 2>/dev/null)" && [ -n "$_rd" ]; then
      _rd="${_rd%$'\r'}"; _rd="${_rd//\\//}"
      for _c in "$_rd"/lib/*/libflang_rt.runtime.a; do
        if [ -f "$_c" ]; then _frt="$_c"; break; fi
      done
      [ -n "$_frt" ] || echo "${0##*/}: warning: no libflang_rt.runtime.a under $_rd/lib/*/; dropping -lflang_rt.runtime, -lgfortran and -lquadmath" >&2
    fi
    _a=()
    for a in "$@"; do
      case "$a" in
        -lflang_rt.runtime|-lgfortran|-lquadmath)
          [ -n "$_frt" ] && _a+=("$_frt")
          _frt=""
          continue ;;
      esac
      _a+=("$a")
    done
    set -- "${_a[@]}"
    ;;
esac

# Windows: zig's MinGW -l search tries only <n>.dll, <n>.lib, lib<n>.a —
# missing lib<n>.dll.a (MinGW import libs, what GNU ld searches first)
# and lib<n>.lib (conda-forge MSVC naming, e.g. libbz2.lib, libcurl.lib).
# Emulate: resolve -lX to an explicit path when only a missed name exists.
case "$(uname -s 2>/dev/null)" in
  MINGW*|MSYS*)
    # -c with one source and no -o: <stem>.o, as MinGW gcc names it (zig
    # writes <stem>.obj; QuickJSR then archives a libquickjs.o that does
    # not exist). rzig: windows.zig's objSuffix.
    _c=0 _no=0 _src=()
    for a in "$@"; do
      case "$a" in
        -c) _c=1 ;;
        -S|-E|-M|-MM|-o|-o?*) _no=1 ;;
        -*) ;;
        *.[cCfFimMsS]|*.cc|*.cp|*.cpp|*.cxx|*.c++|*.CC|*.CPP|*.CXX|*.ii|*.mi|*.mm|*.mii|*.sx|*.cu|*.ll|*.bc|\
        *.for|*.ftn|*.fpp|*.f77|*.f90|*.f95|*.f03|*.f08|*.cuf|*.FOR|*.FTN|*.FPP|*.F77|*.F90|*.F95|*.F03|*.F08|*.CUF) _src+=("$a") ;;
      esac
    done
    if [ $_c = 1 ] && [ $_no = 0 ] && [ ${#_src[@]} = 1 ]; then
      _b=${_src[0]##*/}; _b=${_b##*\\}; set -- "$@" -o "${_b%.*}.o"
    fi
    libdirs=()
    for a in "$@"; do case "$a" in -L?*) libdirs+=("${a#-L}");; esac; done
    args=()
    for a in "$@"; do
      repl=""
      case "$a" in
        -l?*)
          n="${a#-l}"
          # MinGW names upstream zig has no import library for, renamed
          # to the API set both zigs have a .def for (the same imports):
          # Rust's -lsynchronization (WaitOnAddress). rzig: windows.zig's
          # mingw_names.
          case "$n" in synchronization) n=api-ms-win-core-synch-l1-2-0; a="-l$n" ;; esac
          for d in "${libdirs[@]}"; do
            # GNU ld order: shared import lib first, then zig's own names
            if [ -f "$d/lib$n.dll.a" ]; then
              repl="$d/lib$n.dll.a"; break
            elif [ -f "$d/$n.dll" ] || [ -f "$d/$n.lib" ] || [ -f "$d/lib$n.a" ]; then
              break  # zig will find it itself
            elif [ -f "$d/lib$n.lib" ]; then
              repl="$d/lib$n.lib"; break
            fi
          done
          ;;
      esac
      args+=("${repl:-$a}")
    done
    # GNU gcc's -mwindows implies the GDI/shell link set; zig only sets
    # the subsystem, so add what gnuwin32 relies on implicitly.
    if [[ " $* " == *" -mwindows "* ]]; then
      args+=(-lgdi32 -lcomdlg32 -lwinspool -ladvapi32 -lshell32)
    fi
    set -- "${args[@]}"
    ;;
esac

extra=()
if [[ " $* " == *" -shared "* && " $* " != *"-soname"* ]]; then
  prev=""
  for a in "$@"; do
    if [[ "$prev" == "-o" ]]; then
      base="${a##*/}"
      if [[ "$base" == lib*.so* ]]; then
        extra+=("-Wl,-soname,$base")
      fi
      break
    fi
    prev="$a"
  done
fi
# Linux links with a version script: GNU ld's --undefined-version, which
# ld.lld's default refuses (oneTBB's tbbmalloc names symbols it does not
# define). Before the caller's arguments, so its own
# --no-undefined-version wins. rzig: compiler.zig.
if [[ "$(uname -s 2>/dev/null)" == "Linux" && " $* " == *-version-script* ]]; then
  _link=true
  for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM) _link=false; break;; esac; done
  $_link && extra+=(-Wl,--undefined-version)
fi
g0=(-g0)
for a in "$@"; do case "$a" in -g*) g0=(); break;; esac; done
# Linux links without a -g option: --strip-debug. -g0 leaves the DWARF of
# zig's own libc++, libc++abi and libunwind, which zig builds with debug
# info anyway (4 to 6 MB in every C++ package). A -g on the link line
# keeps it. rzig also keeps it when an input object has debug info
# (strip.zig); this shim does not read ELF (a deliberate difference in
# parity-test.sh). rzig: compiler.zig.
if [[ "$(uname -s 2>/dev/null)" == "Linux" && ${#g0[@]} -gt 0 ]]; then
  _link=true
  for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM) _link=false; break;; esac; done
  $_link && extra+=(-Wl,--strip-debug)
fi
# OpenMP: zig cc performs -fopenmp codegen but bundles neither omp.h nor
# libomp and won't auto-link it — wire in llvm-openmp's. They are in the
# environment R lives in, the one Makeconf calls $(R_HOME)/../..: four
# levels above this script in R_HOME/bin/toolchain (on Windows that is
# <prefix>/Library), a conda env or the standalone prefix (build.zig
# installs omp.h there, libomp is vendored). CONDA_PREFIX when the script
# runs from anywhere else (the repo's toolchain/, for configure-only.sh).
omp=()
_ob=""
if [[ " $* " == *"-fopenmp"* ]]; then
  _s="${BASH_SOURCE[0]//\\//}"   # the Windows forwarder passes C:\...\zig-cc
  _ob="${_s%/*}/../../../.."
  if [ ! -f "$_ob/include/omp.h" ]; then
    case "$(uname -s 2>/dev/null)" in
      MINGW*|MSYS*) _ob="${CONDA_PREFIX:+$CONDA_PREFIX/Library}" ;;
      *)            _ob="${CONDA_PREFIX:-}" ;;
    esac
  fi
fi
if [ -n "$_ob" ]; then
  inc="$_ob/include"; lib="$_ob/lib"
  omp+=(-I"$inc")
  linking=true
  for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM) linking=false; break;; esac; done
  # Some packages (e.g. data.table) autoprobe OpenMP themselves and bake
  # an explicit -lomp into PKG_LIBS on top of R's SHLIB_OPENMP_CFLAGS.
  # Adding our own on top double-links libomp.dylib, which newer macOS
  # dyld hard-rejects at load time as a "duplicate linked dylib" error.
  already_linked=false
  for a in "$@"; do case "$a" in -lomp|*/libomp.lib) already_linked=true; break;; esac; done
  if $linking && ! $already_linked; then
    if [ -f "$lib/libomp.lib" ]; then
      omp+=("$lib/libomp.lib")   # zig's -l search misses this name on win
    else
      omp+=(-L"$lib" -lomp)
    fi
  elif $linking; then
    # The caller's own -lomp still needs the directory to find it in:
    # Makeconf's LDFLAGS has it, but a probe that calls $CC directly does
    # not, and data.table's macOS probe (PKG_LIBS=-lomp) then failed to
    # link and built without OpenMP (found 2026-09-30 on a staged slim
    # tree, before Makeconf named the environment at all).
    omp+=(-L"$lib")
  fi
fi

# macOS: dyld (macOS 12+) refuses to load a Mach-O whose LC_LOAD_DYLIB
# list names the same library twice — "duplicate linked dylib". R makes
# that easy to trigger: R CMD SHLIB appends $(FLIBS) to every package link
# that has Fortran sources, and CRAN's documented recipe for Fortran
# packages using BLAS/LAPACK is `PKG_LIBS = $(BLAS_LIBS) $(FLIBS)` — so
# FLIBS lands twice. Harmless while FLIBS carried gfortran's static
# runtime; fatal since Phase 2, where it names libflang_rt.runtime.dylib
# (quadprog, 2026-09-24: "duplicate linked dylib '@rpath/
# libflang_rt.runtime.dylib'"). Same class as the data.table -lomp case
# above, generalised: keep the first occurrence of every -l<name>, drop
# repeats. Dylib link order is irrelevant and a repeated static archive
# resolves nothing new on a Mach-O link, so this is safe for both kinds.
# bash-3.2-safe on purpose (no associative arrays): the bundled copy of
# this shim can run under macOS's system bash.
case "$(uname -s 2>/dev/null)" in
  Darwin)
    _seen=" "; _dedup=()
    for a in "$@"; do
      case "$a" in
        -l?*) case "$_seen" in *" $a "*) continue;; esac; _seen="$_seen$a ";;
      esac
      _dedup+=("$a")
    done
    set -- "${_dedup[@]}" "${omp[@]}"
    omp=()
    # No implicit rpaths: the non-native target above records none for
    # -L directories, so the -L flags pass through untouched. The SDK -L
    # is for links only.
    _link=true
    for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM) _link=false; break;; esac; done
    $_link || sdkL=()
    ;;
esac

exec "${ZIG[@]}" cc -fno-sanitize=undefined -mcpu=baseline -Wno-error=date-time "${g0[@]}" "${target[@]}" "${extra[@]}" "$@" "${omp[@]}" "${sdkL[@]}"
