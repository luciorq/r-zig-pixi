R CMD INSTALL and R CMD SHLIB: make arguments in double quotes on Windows

install.R passes make variables on make's command line in single quotes
(SHLIB_LD='$(SHLIB_CXXLD)', CC='$(CC)', PKG_LIBS='...'). sh strips them on
unix, and so did MSYS2's make, whose cygwin runtime splits its command
line as sh does. A native Windows make (GNU make built for Windows32)
splits it by the C runtime's rules, which keep single quotes: a C++ or
Fortran package that make builds then fails ("No rule to make target
'$(FCLIBS_XTRA)''", or a link line naming "g++.exe -std=gnu++20  " as
the program). Double quotes work with both makes. Unix keeps single
quotes, which stop sh from expanding $(...). Draft for backlog L4: the
native build-tools set (b13-design PLAN.md, L4-F3), not in the series.

--- a/src/library/tools/R/install.R
+++ b/src/library/tools/R/install.R
@@ -1459,6 +1459,7 @@
                         if (!is.na(use_C))
                             sprintf(c("CC='$(CC%s)'", "CFLAGS='$(C%sFLAGS)'"), use_C)
                         else character()
+                    if (WINDOWS) makeargs <- gsub("'", "\"", makeargs, fixed = TRUE)
                     cmd <- paste("make --no-print-directory",
                                  p1("-f", shQuote(makefiles)),
                                  p1(makeargs))
@@ -2959,6 +2960,11 @@
 ##    if(config_val_to_logical(Sys.getenv("_R_USE_STRICT_R_HEADERS_", "FALSE")))
 ##         makeargs <- c(makeargs, "XDEFS=-DSTRICT_R_HEADERS=1")
 
+    ## r-zig: a native Windows make splits its command line by the C
+    ## runtime rules, which keep single quotes (MSYS make stripped them as
+    ## sh does); double quotes work with both. Unix keeps single quotes,
+    ## which stop sh from expanding $(...).
+    if (WINDOWS) makeargs <- gsub("'", "\"", makeargs, fixed = TRUE)
     cmd <- paste(MAKE, p1(paste("-f", shQuote(makefiles))), p1(makeargs),
                  p1(makeobjs))
     ## r-zig (patch 0013): rzig build first (.rzig_build); NA is the make
